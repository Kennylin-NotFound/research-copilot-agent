# Copy to .env and fill in your own values. Never commit the real .env file.

# Chat LLM provider: zhipu | deepseek | openai
LLM_PROVIDER=zhipu

# Zhipu chat + embedding (default example)
ZHIPUAI_API_KEY=
LLM_API_BASE=https://open.bigmodel.cn/api/paas/v4/
LLM_MODEL=glm-4-plus
EXTRACTION_MODEL=glm-4-flash

# DeepSeek chat alternative. Keep secrets only in .env or process environment.
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_EXTRACTION_MODEL=deepseek-v4-flash
# Structured AgentAction uses function-calling; keep thinking disabled for this path.
DEEPSEEK_THINKING=disabled

# Embedding is configured separately so DeepSeek can be used for chat decisions
# while the existing FAISS index continues to use a compatible embedding API.
EMBEDDING_API_KEY=
EMBEDDING_API_BASE=https://open.bigmodel.cn/api/paas/v4/
EMBEDDING_MODEL=embedding-3

AGENT_V2_MAX_ITERATIONS=12
AGENT_V2_MAX_SEARCHES=6
AGENT_V2_MAX_READS=5
AGENT_V2_TIMEOUT_SECONDS=900
AGENT_V2_MAX_NO_PROGRESS=2
AGENT_V2_CHECKPOINT_DB=./data/checkpoints/agent_v2.sqlite

SEARCH_PROVIDER=semantic_scholar
SEMANTIC_SCHOLAR_API_KEY=
TAVILY_API_KEY=

LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=research-copilot
