{
	email {$ACME_EMAIL}
	admin off
}

{$PRODUCT_PUBLIC_HOST} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		-Server
	}

	reverse_proxy api:8080 {
		health_uri /health
		health_interval 30s
		health_timeout 5s
		health_headers {
			Host {$PRODUCT_PUBLIC_HOST}
		}
		flush_interval -1
	}

	log {
		output stdout
		format json
	}
}
