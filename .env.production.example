# Copy to .env.production on the server. Never commit the real file.
PRODUCT_IMAGE=ghcr.io/OWNER/research-copilot-agent:0.1.0
PRODUCT_APP_VERSION=0.1.0
PRODUCT_COMPOSE_PROJECT=research-copilot
PRODUCT_HTTP_PORT=18081
PRODUCT_ALLOWED_HOSTS=research.example.com
PRODUCT_DB_PASSWORD=replace-with-a-long-random-password

LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_EXTRACTION_MODEL=deepseek-flash
DEEPSEEK_THINKING=disabled

EMBEDDING_API_KEY=
EMBEDDING_API_BASE=https://open.bigmodel.cn/api/paas/v4/
EMBEDDING_MODEL=embedding-3

SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
